# BridgeEscrow Backend Configuration
APP_ENV=local
SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true

# Platform Fees
ESCROW_FEE_PERCENTAGE=0.025
ESCROW_MIN_FEE=50.0

# Safaricom Daraja M-Pesa Configuration (Leave blank for Sandbox Simulator)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=http://localhost:5000/api/payments/mpesa/callback

# Verification Security
CODE_EXPIRY_HOURS=48
MAX_VERIFICATION_ATTEMPTS=3
